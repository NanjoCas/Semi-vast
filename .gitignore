# Python cache
__pycache__/
*.py[cod]

# Local environments and caches
.venv/
.cache/
.hf_models/

# Runtime artifacts
*.log

# Data/model/generated artifacts (raw datasets, model weights, processed splits)
Data/
checkpoints/
model_cache/
processed/
.ipynb_checkpoints/
*.pt
*.bin
*.safetensors
*.csv
*.tsv
*.jsonl
*.npz

# outputs/ holds lightweight training records (metrics json, plots) and IS tracked

# Local Claude Code tool permissions (personal, machine-specific)
.claude/settings.local.json

# OS noise
.DS_Store

# Text-free files needed for plots (v3/HANDOFF.md section 4): summary CSVs, every detector's test predictions
# (id, gold, pred, probs) and the exports of v3/tools/export_plot_data.py. Data splits and pools with claim / evidence
# text stay out (processed/, runs*/*/data/, runs*/*/pseudo/).
!v3/results*/*.csv
!v3/runs*/r*/outputs/detector/*/test_predictions.jsonl
!v3/plot_data/**
